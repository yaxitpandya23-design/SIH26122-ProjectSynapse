# ProjectSynapse Environment Configuration
# Duplicate this file as .env for local development (which is gitignored)

# Application
APP_NAME=ProjectSynapse
APP_ENV=development
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Primary Target Database (PostgreSQL 16 with pgvector)
# Example for Docker Compose: postgresql+asyncpg://postgres:postgres@localhost:5432/project_synapse
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/project_synapse

# Local Development Fallback Database (used if PostgreSQL is unavailable)
# SQLite local file URL: sqlite+aiosqlite:///./project_synapse.db
# To force SQLite during local testing without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./project_synapse.db

# AI Provider Configuration
# Supported options: mock, gemini, openai, ollama
# Default is 'mock' for guaranteed zero-network offline demo & tests
AI_PROVIDER=mock

# Cloud AI Keys (Optional - only required if AI_PROVIDER is set to gemini or openai)
GEMINI_API_KEY=
OPENAI_API_KEY=
